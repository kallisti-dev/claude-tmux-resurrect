#!/usr/bin/env bash
# Save the panes' agent sessions in a tmux-resurrect snapshot.
# SPDX-License-Identifier: BSD-3-Clause
set -euo pipefail
# shellcheck source=lib/tmux-agent-resurrect.sh
source "${BASH_SOURCE[0]%/*}/../lib/tmux-agent-resurrect.sh"
require_tmux
need mktemp mv rm
[[ $# == 1 && -f $1 && ! -L $1 ]] || die 'usage: tmux-agent-resurrect-save SNAPSHOT (a regular resurrect snapshot, not a symlink)'
snapshot=$1
umask 077
records=$(mktemp "${snapshot}.agent-resurrect-records.XXXXXX")
running_panes=$(mktemp "${snapshot}.agent-resurrect-running.XXXXXX")
output=$(mktemp "${snapshot}.agent-resurrect-save.XXXXXX")
trap 'rm -f -- "$records" "$running_panes" "$output"' EXIT

# Use snapshot pane identities rather than whitespace-delimited list-panes.
# This also respects resurrect's decision to omit grouped sessions. Each line
# holds the pane's command and full command line, each after a colon that
# keeps an empty one a field, and its identity.
unrecorded=() targets=()
while IFS=$'\t' read -r command full row; do
  command=${command#:}
  full=${full#:}
  target=$(jq -r '"=" + .session + ":" + .window + "." + .pane' <<<"$row")
  pane=$(tmux display-message -p -t "$target" '#{pane_id}' 2>/dev/null) || continue
  [[ -n $pane ]] || continue
  running=$(agent_of_pane "$command" "$full")
  [[ -z $running ]] || printf '%s\n' "$row" >>"$running_panes"
  session=$(pane_session "$pane")
  if [[ -z $session ]]; then
    # Keep sessions still waiting to launch, and those dispatched whose agent
    # has not reported them yet.
    pending=$(pane_option "$pane" @agent-resurrect-resume-data)
    if [[ -n $pending ]] && valid_record "$pending"; then
      jq -c --argjson row "$row" '. + $row' <<<"$pending" >>"$records"
    elif [[ -n $running ]] && ! reports_late "$running"; then
      unrecorded+=("$pane")
      targets+=("$(agent_label "$running") in ${target#=}")
    fi
    continue
  fi
  agent=${session%% *}
  id=${session#* }
  if [[ " $agents " != *" $agent "* ]] || ! valid_id "$id"; then
    warn "invalid session on $pane: $session; skipping"
    continue
  fi
  # Without a reliable end report, a recorded session counts only while its
  # agent is still running in the pane.
  if reports_late "$agent" && [[ $running != "$agent" ]]; then
    continue
  fi
  dir=$(pane_option "$pane" @agent-resurrect-cwd)
  [[ $dir == /* ]] || dir=$(tmux display-message -p -t "$pane" '#{pane_current_path}')
  worktree=''
  launch=$(pane_option "$pane" @agent-resurrect-launch)
  jq -e 'type == "object"' >/dev/null 2>&1 <<<"$launch" || launch='{}'
  if [[ $agent == claude ]]; then
    if transcript=$(find_transcript "$id" "$(claude_projects_dir "$launch")"); then
      # The latest valid absolute cwd, and the latest permission mode. JSON
      # decoding handles spaces, escaping and pretty/partially written lines.
      latest=$(jq -cRn '
        reduce inputs as $line ({};
          (try ($line | fromjson) catch null) as $entry |
          if ($entry | type) != "object" then .
          else
            (if ($entry.cwd | type) == "string" and ($entry.cwd | startswith("/"))
              then .cwd = $entry.cwd else . end) |
            (if ($entry.permissionMode | type) == "string"
              then .mode = $entry.permissionMode else . end)
          end)
      ' "$transcript")
      last_cwd=$(jq -r '.cwd // empty' <<<"$latest")
      [[ -z $last_cwd ]] || dir=$last_cwd
      # Resuming restores the permission mode, except bypassing permissions,
      # which needs the option again.
      if [[ $(jq -r '.mode // empty' <<<"$latest") == bypassPermissions ]]; then
        launch=$(jq -c '.options = ((.options // []) + ["--dangerously-skip-permissions"])' <<<"$launch")
      fi
    else
      warn "no unique transcript for $id; saving pane directory as fallback"
    fi
    worktree=$(worktree_name "$dir")
  fi
  record=$(jq -c --arg agent "$agent" --arg cwd "$dir" --arg id "$id" --arg worktree "$worktree" \
    --argjson launch "$launch" \
    '$launch + . + {version: 1, agent: $agent, cwd: $cwd, session_id: $id, worktree: $worktree}' <<<"$row")
  if valid_record "$record"; then
    printf '%s\n' "$record" >>"$records"
  else
    warn "unsupported metadata on $pane (control characters or invalid pane identity); skipping"
  fi
done < <(jq -Rr 'split("\t") | select(.[0] == "pane" and length >= 11) |
  ":\(.[9])\t\(.[10])\t\({session: .[1], window: .[2], pane: .[5]} | tojson)"' "$snapshot")

# Automatic saves repeat, so warn only when the set of agent panes without a
# recorded session changes.
panes=${unrecorded[*]:-}
if [[ $panes != "$(tmux show-options -gqv @agent-resurrect-unrecorded)" ]]; then
  if [[ -n $panes ]]; then
    tmux set-option -g @agent-resurrect-unrecorded "$panes"
    if [[ ${#targets[@]} == 1 ]]; then
      fix='restart it in a new pane so it can be resumed'
    else
      fix='restart them in new panes so they can be resumed'
    fi
    notify "no session recorded for $(summarize "${targets[@]}"); $fix"
  else
    tmux set-option -gu @agent-resurrect-unrecorded
  fi
fi

# Field 11 must be exactly ":" to suppress resurrect's generic process restart.
# A recorded agent may run as node or under a shell, so include mapped panes,
# and those whose command line shows an agent.
jq -Rr --slurpfile records "$records" --slurpfile running "$running_panes" \
  --arg agents "(^|/)\\.?(${agents// /|})(\$|[-. ])" '
  split("\t") as $f |
  if $f[0] == "agent-resurrect" then empty
  elif $f[0] == "pane" and ($f | length) >= 11 and
    (($f[9] | test($agents; "i")) or
      any($records[], $running[]; .session == $f[1] and .window == $f[2] and .pane == $f[5]))
  then $f | .[10] = ":" | join("\t")
  else . end
' "$snapshot" >"$output"
while IFS= read -r record; do
  printf 'agent-resurrect\t%s\n' "$record" >>"$output"
done <"$records"
mv -- "$output" "$snapshot"
