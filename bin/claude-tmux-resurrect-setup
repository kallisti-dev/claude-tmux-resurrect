#!/usr/bin/env bash
# Register this integration alongside existing tmux and resurrect hooks, and
# list the plugin in CLAUDE_CODE_PLUGIN_DIRS for Claude sessions in new panes.
# SPDX-License-Identifier: BSD-3-Clause
set -euo pipefail
# shellcheck source=lib/claude-tmux-resurrect.sh
source "${BASH_SOURCE[0]%/*}/../lib/claude-tmux-resurrect.sh"
require_tmux
[[ $# == 0 || ($# == 1 && ${1:-} == --remove) ]] || die 'usage: claude-tmux-resurrect-setup [--remove]'
bin_dir=$(cd -- "${BASH_SOURCE[0]%/*}" && pwd)
plugin_dir=${bin_dir%/bin}
prefix=@claude-tmux-resurrect
variable=CLAUDE_CODE_PLUGIN_DIRS

# Serialize reloads without clearing or rebuilding another plugin's hook array.
tmux wait-for -L claude-tmux-resurrect-setup
trap 'tmux wait-for -U claude-tmux-resurrect-setup' EXIT

option() { tmux show-options -gqv "$1"; }

# Print tmux's global value of CLAUDE_CODE_PLUGIN_DIRS, if it has one.
plugin_dirs() {
  local line
  if line=$(tmux show-environment -g "$variable" 2>/dev/null) && [[ $line == "$variable="* ]]; then
    printf '%s' "${line#"$variable="}"
  fi
}

# Usage: update_plugin_dirs REMOVE [ADD]
# Rewrite tmux's global CLAUDE_CODE_PLUGIN_DIRS without the directory REMOVE,
# appending ADD if given. Other directories keep their order. New panes
# inherit the result; running processes keep the value they started with.
update_plugin_dirs() {
  local remove=$1 add=${2:-} entry value='' entries=()
  IFS=: read -ra entries <<<"$(plugin_dirs)"
  for entry in ${entries[@]+"${entries[@]}"}; do
    [[ -n $entry && $entry != "$remove" && $entry != "$add" ]] || continue
    value+=${value:+:}$entry
  done
  [[ -z $add ]] || value+=${value:+:}$add
  if [[ -n $value ]]; then
    tmux set-environment -g "$variable" "$value"
  else
    tmux set-environment -gu "$variable"
  fi
}

# Usage: guarded QUOTED_PATH
# Print a shell command that runs QUOTED_PATH, a path already quoted for the
# shell, with any arguments appended to the command. Once the path no longer
# exists, the command succeeds without running anything: tmux keeps these
# registrations until its server exits, even after a plugin manager deletes
# this directory.
guarded() { printf '[ ! -e %s ] || %s' "$1" "$1"; }

compose_hook() {
  local phase=$1 previous=$2 own=$3 name
  if [[ -z $previous ]]; then
    printf '%s' "$own"
    return
  fi
  name=__claude_tmux_resurrect_${phase//-/_}
  printf '%s\n' "$name() {" '  local previous_status=0 own_status=0'
  if [[ $phase == pre-restore-all ]]; then
    printf '  %s "$@" || own_status=$?\n' "$own"
  fi
  # A subshell keeps an existing hook's exit from skipping our cleanup. Match
  # resurrect's argument convention: append arguments to its shell command.
  printf '  (\n%s "$@"\n  ) || previous_status=$?\n' "$previous"
  if [[ $phase != pre-restore-all ]]; then
    printf '  %s "$@" || own_status=$?\n' "$own"
  fi
  # These expressions are expanded later, by the hook's shell.
  # shellcheck disable=SC2016
  printf '%s\n' \
    '  if [[ $own_status != 0 ]]; then return "$own_status"; fi' \
    '  return "$previous_status"' '}' "$name"
}

register_resurrect_hook() {
  local phase=$1 script=$2 current managed previous own command
  current=$(option "@resurrect-hook-$phase")
  managed=$(option "$prefix-managed-$phase")
  previous=$(option "$prefix-previous-$phase")
  own=$(guarded "$(quote "$bin_dir/$script")")
  if [[ -z $managed || $current != "$managed" ]]; then
    # Do not capture a wrapper around one of our generated functions and then
    # nest it again. A directly replaced hook is safe to capture on reload.
    [[ -z $managed || $current != *"$managed"* ]] || die "@resurrect-hook-$phase wraps a setup-generated hook; reset that option before running setup"
    [[ $current != *'__claude_tmux_resurrect_'* ]] || die "@resurrect-hook-$phase wraps a setup-generated hook; reset that option before running setup"
    previous=$current
    # Adopt our own command, set without bookkeeping, without running it twice.
    [[ $previous != "$own" ]] || previous=''
  fi
  command=$(compose_hook "$phase" "$previous" "$own")
  tmux set-option -g "$prefix-previous-$phase" "$previous"
  tmux set-option -g "$prefix-managed-$phase" "$command"
  tmux set-option -g "@resurrect-hook-$phase" "$command"
}

remove_resurrect_hook() {
  local phase=$1 managed previous
  managed=$(option "$prefix-managed-$phase")
  previous=$(option "$prefix-previous-$phase")
  if [[ -n $managed && $(option "@resurrect-hook-$phase") == "$managed" ]]; then
    if [[ -n $previous ]]; then
      tmux set-option -g "@resurrect-hook-$phase" "$previous"
    else
      tmux set-option -gu "@resurrect-hook-$phase"
    fi
  fi
  tmux set-option -gu "$prefix-previous-$phase"
  tmux set-option -gu "$prefix-managed-$phase"
}

register_event_hook() {
  local event=$1 handler=$2 slot expected entries entry index used=' '
  slot=$(option "$prefix-$event-slot")
  expected=$(option "$prefix-$event-handler")
  if [[ ! $slot =~ ^[0-9]+$ || -z $expected || $(option "${event}[$slot]") != "$expected" ]]; then
    entries=$(tmux show-hooks -g "$event")
    while IFS= read -r entry; do
      index=${entry#"${event}["}
      [[ $index != "$entry" ]] || continue
      index=${index%%]*}
      [[ $index =~ ^[0-9]+$ ]] && used+="$index "
    done <<<"$entries"
    slot=0
    while [[ $used == *" $slot "* ]]; do
      slot=$((slot + 1))
    done
  fi
  tmux set-hook -g "${event}[$slot]" "$handler"
  tmux set-option -g "$prefix-$event-slot" "$slot"
  tmux set-option -g "$prefix-$event-handler" "$(option "${event}[$slot]")"
}

remove_event_hook() {
  local event=$1 slot expected
  slot=$(option "$prefix-$event-slot")
  expected=$(option "$prefix-$event-handler")
  if [[ $slot =~ ^[0-9]+$ && -n $expected && $(option "${event}[$slot]") == "$expected" ]]; then
    tmux set-hook -gu "${event}[$slot]"
  fi
  tmux set-option -gu "$prefix-$event-slot"
  tmux set-option -gu "$prefix-$event-handler"
}

if [[ ${1:-} == --remove ]]; then
  for phase in post-save-layout pre-restore-all post-restore-all; do
    remove_resurrect_hook "$phase"
  done
  for event in client-attached client-session-changed; do
    remove_event_hook "$event"
  done
  listed=$(option "$prefix-dir")
  [[ -z $listed ]] || update_plugin_dirs "$listed"
  tmux set-option -gu "$prefix-dir"
  tmux set-option -gu "$prefix-version"
else
  [[ $plugin_dir != *:* ]] || die "$variable cannot list a directory whose path contains ':': $plugin_dir"
  register_resurrect_hook post-save-layout claude-tmux-resurrect-save
  register_resurrect_hook pre-restore-all claude-tmux-resurrect-pre-restore
  register_resurrect_hook post-restore-all claude-tmux-resurrect-post-restore
  # Escape literal # in installation paths before run-shell expands formats.
  arm=$(guarded "$(quote "${bin_dir//#/##}/claude-tmux-resurrect-arm")")
  # Attaching also changes the client's session, so only the attach hook
  # passes the client that shows messages kept while none was attached.
  register_event_hook client-attached "run-shell -b $(quote "$arm #{q:session_id} #{q:client_name}")"
  register_event_hook client-session-changed "run-shell -b $(quote "$arm #{q:session_id}")"
  # Claude Code loads each listed directory in place as a session-only
  # plugin, which runs this plugin's hooks/hooks.json.
  listed=$(option "$prefix-dir")
  update_plugin_dirs "$listed" "$plugin_dir"
  tmux set-option -g "$prefix-dir" "$plugin_dir"
  # The Claude hook compares its own version with this one.
  tmux set-option -g "$prefix-version" "$(plugin_version "$plugin_dir")"
  # Existing panes keep the environment they started with. When tmux starts,
  # the configuration loads before any pane exists.
  if [[ -z $listed && -n $(tmux list-panes -a -F . 2>/dev/null) ]]; then
    notify 'loaded; start Claude in a new pane so tmux-resurrect can resume it'
  fi
fi
