#!/usr/bin/env bash
# Resume pending agent sessions when their tmux session is attached.
# SPDX-License-Identifier: BSD-3-Clause
set -euo pipefail
# shellcheck source=lib/tmux-agent-resurrect.sh
source "${BASH_SOURCE[0]%/*}/../lib/tmux-agent-resurrect.sh"
require_tmux
[[ $# == 1 || $# == 2 ]] || die 'usage: tmux-agent-resurrect-arm TMUX_SESSION_ID [CLIENT]'
session=$1
# Attach hooks pass the client, which can show messages kept for it.
[[ -z ${2:-} ]] || show_kept_notices "$2"
[[ -n $session ]] || exit 0
[[ $session =~ ^\$[0-9]+$ ]] || die "tmux-agent-resurrect-arm expects a tmux session ID (\$N), not a name"
[[ $(tmux show-options -gqv @agent-resurrect-restoring) != 1 ]] || exit 0
[[ $(tmux show-options -qv -t "$session" @agent-resurrect-pending 2>/dev/null) == 1 ]] || exit 0
[[ $(tmux display-message -p -t "$session" '#{session_attached}') != 0 ]] || exit 0

# Two clients may attach simultaneously. Serialize the read/send/clear sequence.
lock=tmux-agent-resurrect-arm-${session#\$}
tmux wait-for -L "$lock"
trap 'tmux wait-for -U "$lock"' EXIT
[[ $(tmux show-options -gqv @agent-resurrect-restoring) != 1 ]] || exit 0
remaining=0
while IFS= read -r pane; do
  record=$(pane_option "$pane" @agent-resurrect-resume-data)
  [[ -n $record ]] || continue
  # A dispatched record stays until the agent reports its session, so that
  # saves keep it if the command fails in the pane's shell.
  [[ -z $(pane_option "$pane" @agent-resurrect-launched) ]] || continue
  if [[ -n $(pane_session "$pane") ]]; then
    tmux set-option -pu -t "$pane" @agent-resurrect-resume-cmd
    tmux set-option -pu -t "$pane" @agent-resurrect-resume-data
    continue
  fi
  agent=$(jq -r '.agent' <<<"$record" 2>/dev/null) || agent=''
  label=$(agent_label "${agent:-agent}")
  # Do not type into an editor, copy mode, or another foreground application.
  command=$(tmux display-message -p -t "$pane" '#{pane_current_command}')
  where=$(tmux display-message -p -t "$pane" '#{session_name}:#{window_index}.#{pane_index}')
  case "$command" in
    bash | zsh | sh | dash | ksh) ;;
    *)
      notify "$label in $where resumes on a later attach, once its pane is at a shell prompt"
      remaining=1
      continue
      ;;
  esac
  if [[ $(tmux display-message -p -t "$pane" '#{pane_in_mode}') != 0 ]]; then
    notify "$label in $where resumes on a later attach, once its pane leaves copy mode"
    remaining=1
    continue
  fi
  status=0
  cmd=$(resume_command "$record") || status=$?
  if [[ $status == 2 ]]; then
    # It waits for a directory, which restore reported.
    remaining=1
    continue
  elif [[ $status != 0 ]]; then
    tmux set-option -pu -t "$pane" @agent-resurrect-resume-cmd
    tmux set-option -pu -t "$pane" @agent-resurrect-resume-data
    continue
  fi
  tmux set-option -p -t "$pane" @agent-resurrect-resume-cmd "$cmd"
  # Literal mode prevents tmux interpreting command text as key names.
  tmux send-keys -l -t "$pane" "$cmd"
  tmux send-keys -t "$pane" Enter
  tmux set-option -p -t "$pane" @agent-resurrect-launched 1
done < <(tmux list-panes -s -t "$session" -F '#{pane_id}')
if [[ $remaining == 0 ]]; then
  tmux set-option -u -t "$session" @agent-resurrect-pending
fi
